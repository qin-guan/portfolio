---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Qin Guan', description = 'Average software enjoyer' } = Astro.props;
const pageTitle = title === 'Qin Guan' ? title : `${title} | Qin Guan`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/seats', label: 'Seats' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: 'https://qinguan.me/cv.pdf', label: 'CV', external: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-adsense-account" content="ca-pub-1586897931312395" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <script is:inline id="ms-clarity">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "jx1ybrea62");
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Primary">
        <a class="nav-brand" href="/">Qin Guan</a>
        <div class="nav-links">
          {nav.map((item) => (
            item.external ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
            ) : (
              <a href={item.href} aria-current={path === item.href || (item.href !== '/' && path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>
            )
          ))}
        </div>
        <div class="social">
          <a href="https://github.com/qin-guan" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://linkedin.com/in/qin-guan" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </nav>
    </header>
    <main class="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Average software enjoyer · <a href="https://qinguan.me">qinguan.me</a></p>
    </footer>
  </body>
</html>
